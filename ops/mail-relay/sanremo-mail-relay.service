[Unit]
Description=Sanremo lead mail relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sanremo-relay
Group=sanremo-relay
EnvironmentFile=/etc/sanremo-mail-relay.env
WorkingDirectory=/opt/sanremo-mail-relay
ExecStart=/usr/bin/python3 /opt/sanremo-mail-relay/server.py
Restart=always
RestartSec=5
StateDirectory=sanremo-mail-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sanremo-mail-relay

[Install]
WantedBy=multi-user.target
